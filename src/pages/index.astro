---
import Layout from '~/layouts/PageLayout.astro';
import { findLatestPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

const metadata = {
  title: 'Emjay — Tools, worlds and words',
  description:
    'Emjay — Urth roleplayer (Free Pax States, Kilumi conlang) sharing worldbuilding and open-source tooling (XCF Sync, PowerCordKit).',
  ignoreTitleTemplate: true,
};

const latestPosts = await findLatestPosts({ count: 3 });
---

<Layout metadata={metadata}>
  <Fragment slot="announcement" />

  <!-- HERO / FIELD HEADER -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 pt-12 pb-8 sm:pt-16">
    <p class="font-mono2 text-[11px] sm:text-xs tracking-[0.2em] uppercase opacity-70">
      EMJAY — PORTFOLIO
    </p>
    <h1 class="font-display text-4xl sm:text-6xl leading-[1.05] mt-4 max-w-3xl">
      Tools for communities,<br />
      <span class="italic font-medium">worlds and words I construct.</span>
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
      I'm Emjay — I roleplay on Urth as
      <a class="text-default hover:underline underline-offset-4 font-semibold" href="https://github.com/EmjayBot/free-pax-states" target="_blank" rel="noopener">Free Pax States</a>
      and I'm developing the <strong class="text-default">Kilumi</strong> conlang.
      Here I share my worldbuilding and the open-source tooling:
      <a class="text-default hover:underline underline-offset-4 font-semibold" href="https://github.com/EmjayBot/xcf-git-sync" target="_blank" rel="noopener">XCF Sync</a>, the tool behind
      <a class="text-default hover:underline underline-offset-4 font-semibold" href="https://atlas.urthmaps.com/" target="_blank" rel="noopener">Urth Atlas</a> — plus
      <a class="text-default hover:underline underline-offset-4 font-semibold" href="https://github.com/EmjayBot/powercordkit" target="_blank" rel="noopener">PowerCordKit</a>,
      Discord mod tools + a unified mod inbox.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/worldbuilding"
        class="inline-flex items-center gap-2 rounded-full bg-neutral-900 px-6 py-3 text-sm font-semibold text-[#F7F3EA] hover:bg-neutral-700 dark:bg-[#E8DCC4] dark:text-neutral-900 dark:hover:bg-white transition"
      >
        <span aria-hidden="true">◈</span> Urth roleplay (OOC)
      </a>
      <a
        href="/xcf-sync"
        class="font-mono2 inline-flex items-center gap-2 rounded-full border emjay-rule px-6 py-3 text-sm hover:bg-black/5 dark:hover:bg-white/10 transition"
      >
        <span class="opacity-60">$</span> xcf-sync --push
      </a>
      <a
        href="/powercordkit"
        class="font-mono2 inline-flex items-center gap-2 rounded-full border emjay-rule px-6 py-3 text-sm hover:bg-black/5 dark:hover:bg-white/10 transition"
      >
        <span class="opacity-60">⌁</span> powercordkit
      </a>
    </div>
    <div class="font-mono2 mt-8 flex flex-wrap gap-x-6 gap-y-2 text-[11px] tracking-widest uppercase opacity-60 border-t emjay-rule pt-4">
      <span>urth roleplay (ooc)</span>
      <span>xcf-git-sync on PyPI</span>
      <span>powercordkit live</span>
      <span>urth atlas live</span>
    </div>
  </section>

  <!-- SPLIT: ATLAS + TERMINAL -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 pb-4 grid gap-4 md:grid-cols-2">
    <!-- Worldbuilding card -->
    <a href="/worldbuilding" class="emjay-card group rounded-2xl p-7 sm:p-8 block hover:-translate-y-0.5 transition-transform">
      <div class="flex items-center justify-between">
        <p class="font-mono2 text-[11px] tracking-[0.2em] uppercase" style="color: var(--emjay-stamp)">
          ▚ Urth roleplay — OOC
        </p>
        <p class="font-mono2 text-[11px] opacity-50">OFF-SITE CANON</p>
      </div>
      <h2 class="font-display text-3xl mt-4">Free Pax States</h2>
      <p class="mt-3 text-muted leading-relaxed">
        I roleplay on Urth. To respect Urth's strict no-AI writing rule, no lore, language data,
        or stories are published here — canon lives off-site in my human-written notes.
      </p>
      <ul class="mt-5 space-y-2 text-sm">
        <li class="border-t emjay-rule pt-2 flex justify-between gap-4">
          <span>Canon lives off-site, human-written only</span><span class="font-mono2 text-xs opacity-50">OOC</span>
        </li>
        <li class="border-t emjay-rule pt-2 flex justify-between gap-4">
          <span>No lexicon, grammar, or treaty text here</span><span class="font-mono2 text-xs opacity-50">OOC</span>
        </li>
        <li class="border-t border-b emjay-rule py-2 flex justify-between gap-4">
          <span>Tooling that supports the maps, below</span><span class="font-mono2 text-xs opacity-50">TOOLS</span>
        </li>
      </ul>
      <p class="mt-5 text-sm font-semibold group-hover:underline underline-offset-4">
        Open the OOC note →
      </p>
    </a>

    <!-- Terminal card -->
    <a href="/xcf-sync" class="emjay-terminal group rounded-2xl p-7 sm:p-8 block text-[#EDE6D3] hover:-translate-y-0.5 transition-transform">
      <div class="flex items-center justify-between font-mono2 text-[11px] tracking-[0.2em] uppercase opacity-70">
        <p><span class="inline-block w-2.5 h-2.5 rounded-full bg-red-400/80 mr-1 align-middle"></span><span class="inline-block w-2.5 h-2.5 rounded-full bg-yellow-300/80 mr-2 align-middle"></span> xcf-sync — zsh</p>
        <p>MIT</p>
      </div>
      <h2 class="font-display text-3xl mt-4 text-[#F5EEDC]">XCF Sync</h2>
      <p class="font-mono2 mt-4 text-[13px] leading-relaxed opacity-80">
        <span class="opacity-50">$</span> pip install xcf-git-sync<br />
        <span class="opacity-50">$</span> watch maps/*.xcf --push <span class="opacity-50">— layers ship on save</span>
      </p>
      <div class="font-mono2 mt-5 text-[13px] border-t border-white/10">
        <div class="flex justify-between py-2 border-b border-white/10"><span>tagged layers → PNG</span><span class="text-green-300/90">● auto</span></div>
        <div class="flex justify-between py-2 border-b border-white/10"><span>GIMP 2.10 + 3</span><span class="text-green-300/90">● supported</span></div>
        <div class="flex justify-between py-2"><span>proof: Urth Atlas</span><span class="text-green-300/90">● live</span></div>
      </div>
      <p class="font-mono2 mt-5 text-sm text-[#E8DCC4] group-hover:underline underline-offset-4">
        $ open the tool →
      </p>
    </a>
  </section>

  <!-- POWERCORDKIT BANNER -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 pb-4">
    <a href="/powercordkit" class="emjay-card group rounded-2xl p-7 sm:p-8 block hover:-translate-y-0.5 transition-transform">
      <div class="flex items-center justify-between">
        <p class="font-mono2 text-[11px] tracking-[0.2em] uppercase" style="color: var(--emjay-stamp)">
          ⌁ PowerCordKit — Discord mod suite
        </p>
        <p class="font-mono2 text-[11px] opacity-50">WORKERS + D1 // MIT</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 md:items-center mt-4">
        <div>
          <h2 class="font-display text-3xl">Every server, every forum. One inbox.</h2>
          <p class="mt-3 text-muted leading-relaxed">
            11 static mod tools plus a unified inbox — tickets, ideas, roadmap, ban sync, timeouts,
            appeals — on Cloudflare Workers + D1. Clone it, skin it, self-host it.
          </p>
        </div>
        <ul class="font-mono2 text-[13px] space-y-0 border-t emjay-rule">
          <li class="flex justify-between gap-4 py-2.5 border-b emjay-rule"><span>tools hub + mail inbox</span><span class="opacity-50">● live</span></li>
          <li class="flex justify-between gap-4 py-2.5 border-b emjay-rule"><span>ban sync · timeouts · appeals</span><span class="opacity-50">● modtools</span></li>
          <li class="flex justify-between gap-4 py-2.5"><span>powercordkit.emjay.fyi</span><span class="opacity-50">● demo →</span></li>
        </ul>
      </div>
      <p class="mt-5 text-sm font-semibold group-hover:underline underline-offset-4">
        Open PowerCordKit →
      </p>
    </a>
  </section>

  <!-- FIELD LOG -->  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-10">
    <div class="flex items-end justify-between border-b emjay-rule pb-3">
      <h3 class="font-mono2 text-xs tracking-[0.2em] uppercase opacity-70">Log</h3>
      <a href="/blog" class="text-sm font-semibold hover:underline underline-offset-4">All entries →</a>
    </div>
    {latestPosts.length === 0 ? (
      <p class="text-sm text-muted mt-4">
        No public notes right now — Urth lore stays off-site (human-written only). Tool updates ship with releases on GitHub.
      </p>
    ) : (
    <div class="grid sm:grid-cols-3 gap-4 mt-4">
      {
        latestPosts.map((post) => (
          <a
            href={getPermalink(post.permalink, 'post')}
            class="emjay-card rounded-xl p-5 block hover:-translate-y-0.5 transition-transform"
          >
            <p class="font-mono2 text-[11px] opacity-50 uppercase tracking-widest">
              {getFormattedDate(post.publishDate)}
              {post.category ? ` · ${post.category.title}` : ''}
            </p>
            <p class="font-display text-xl mt-2">{post.title}</p>
            {post.excerpt && <p class="text-sm text-muted mt-2 line-clamp-3">{post.excerpt}</p>}
          </a>
        ))
      }
    </div>
    )}
    <p class="font-mono2 text-[11px] tracking-widest uppercase opacity-50 mt-8 text-center">
      Code MIT · No trackers · RSS inside
    </p>
  </section>
</Layout>
