---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Worldbuilding on Urth',
  description:
    'Emjay roleplays on Urth — canon lives on TEPwiki and the FPS showcase portal. This page is out-of-character links only, no lore text.',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement" />

  <section class="mx-auto max-w-4xl px-4 sm:px-6 py-12 sm:py-16">
    <p class="font-mono2 text-[11px] tracking-[0.2em] uppercase opacity-60">URTH // FREE PAX STATES</p>
    <h1 class="font-display text-4xl sm:text-5xl mt-3">Worldbuilding</h1>
    <p class="text-xl text-muted mt-4 leading-relaxed">
      I roleplay on <a class="font-semibold text-default hover:underline underline-offset-4" href="https://tep.wiki/wiki/Urth" target="_blank" rel="noopener">Urth</a>
      as the Free Pax States. Urth has a strict no-AI writing rule, so all
      canon below is human-written and lives off-site — this page is links only.
    </p>

    <div class="mt-8 grid gap-4">
      <a
        href="https://emjaybot.github.io/free-pax-states/"
        target="_blank"
        rel="noopener"
        class="emjay-card group rounded-2xl p-7 sm:p-8 block hover:-translate-y-0.5 transition-transform"
      >
        <div class="flex items-center justify-between">
          <p class="font-mono2 text-[11px] tracking-[0.2em] uppercase" style="color: var(--emjay-stamp)">
            ▚ Free Pax States — showcase portal
          </p>
          <p class="font-mono2 text-[11px] opacity-50">PORTAL ↗</p>
        </div>
        <p class="mt-3 leading-relaxed text-muted">
          Factbook at a glance, states & territories, and destinations — synced from the Census
          Office sheet and TEPwiki.
        </p>
        <p class="mt-4 text-sm font-semibold group-hover:underline underline-offset-4">
          Open the portal →
        </p>
      </a>

      <a
        href="https://emjaybot.github.io/free-pax-states/census/"
        target="_blank"
        rel="noopener"
        class="emjay-card group rounded-2xl p-7 sm:p-8 block hover:-translate-y-0.5 transition-transform"
      >
        <div class="flex items-center justify-between">
          <p class="font-mono2 text-[11px] tracking-[0.2em] uppercase" style="color: var(--emjay-stamp)">
            ▚ Census & Data Office — economic data
          </p>
          <p class="font-mono2 text-[11px] opacity-50">POP + GDP ↗</p>
        </div>
        <p class="mt-3 leading-relaxed text-muted">
          Population and GDP (nominal + PPP) per state and territory, live from the FPS Census
          Office sheet.
        </p>
        <p class="mt-4 text-sm font-semibold group-hover:underline underline-offset-4">
          Open the data →
        </p>
      </a>

      <a
        href="https://tep.wiki/wiki/Free_Pax_States"
        target="_blank"
        rel="noopener"
        class="emjay-card group rounded-2xl p-7 sm:p-8 block hover:-translate-y-0.5 transition-transform"
      >
        <div class="flex items-center justify-between">
          <p class="font-mono2 text-[11px] tracking-[0.2em] uppercase" style="color: var(--emjay-stamp)">
            ▚ Free Pax States on TEPwiki
          </p>
          <p class="font-mono2 text-[11px] opacity-50">FACTBOOK ↗</p>
        </div>
        <p class="mt-3 leading-relaxed text-muted">
          The full nation factbook — history, government, economy, culture. Canon reference, on
          Urth's encyclopedia.
        </p>
        <p class="mt-4 text-sm font-semibold group-hover:underline underline-offset-4">
          Read the factbook →
        </p>
      </a>

      <a
        href="https://tep.wiki/wiki/Kilumi"
        target="_blank"
        rel="noopener"
        class="emjay-card group rounded-2xl p-7 sm:p-8 block hover:-translate-y-0.5 transition-transform"
      >
        <div class="flex items-center justify-between">
          <p class="font-mono2 text-[11px] tracking-[0.2em] uppercase" style="color: var(--emjay-stamp)">
            ◐ Kilumi on TEPwiki
          </p>
          <p class="font-mono2 text-[11px] opacity-50">LANGUAGE ↗</p>
        </div>
        <p class="mt-3 leading-relaxed text-muted">
          The conlang's canon reference — classification, dialects, and status. My working notes
          stay with my human-written drafts.
        </p>
        <p class="mt-4 text-sm font-semibold group-hover:underline underline-offset-4">
          Read about Kilumi →
        </p>
      </a>
    </div>

    <p class="mt-8 text-sm">
      <a href="/xcf-sync" class="font-mono2 text-sm font-semibold hover:underline underline-offset-4">$ open xcf-sync — the map pipeline</a>
      <span class="mx-2 opacity-40">·</span>
      <a href="/powercordkit" class="font-mono2 text-sm hover:underline underline-offset-4">⌁ powercordkit</a>
    </p>
  </section>
</Layout>
