---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Urth roleplay (OOC)',
  description: 'Emjay roleplays on Urth. Canon is human-written and lives off-site — this page is out-of-character only.',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement" />

  <section class="mx-auto max-w-4xl px-4 sm:px-6 py-12 sm:py-16">
    <p class="font-mono2 text-[11px] tracking-[0.2em] uppercase opacity-60">URTH // OUT OF CHARACTER</p>
    <h1 class="font-display text-4xl sm:text-5xl mt-3">Urth roleplay</h1>
    <p class="text-xl text-muted mt-4 leading-relaxed">
      I roleplay on Urth as the Free Pax States. Urth has a strict no-AI writing rule, so no lore,
      language data, treaties, or stories are published on this site.
    </p>

    <div class="emjay-card rounded-2xl p-7 sm:p-8 mt-8">
      <div class="flex items-center justify-between">
        <p class="font-mono2 text-[11px] tracking-[0.2em] uppercase" style="color: var(--emjay-stamp)">
          ▚ OOC note
        </p>
        <p class="font-mono2 text-[11px] opacity-50">HUMAN-WRITTEN CANON ONLY</p>
      </div>
      <ul class="mt-5 text-[15px] space-y-0 border-t emjay-rule">
        <li class="flex justify-between gap-4 py-2.5 border-b emjay-rule">
          <span>Canon lives off-site in my own human-written notes</span>
          <span class="font-mono2 text-xs opacity-50 shrink-0">OOC</span>
        </li>
        <li class="flex justify-between gap-4 py-2.5 border-b emjay-rule">
          <span>Nothing here is in-character or citable for RP</span>
          <span class="font-mono2 text-xs opacity-50 shrink-0">OOC</span>
        </li>
        <li class="flex justify-between gap-4 py-2.5 border-b emjay-rule">
          <span>Maps + tooling below are the only public artifacts</span>
          <span class="font-mono2 text-xs opacity-50 shrink-0">TOOLS</span>
        </li>
      </ul>
      <p class="mt-5 text-sm text-muted">
        Code-side mirror (tooling configs only, no lore):
        <a
          class="font-semibold text-default hover:underline underline-offset-4"
          href="https://github.com/EmjayBot/free-pax-states"
          target="_blank"
          rel="noopener">Free Pax States on GitHub →</a
        >
      </p>
    </div>

    <div class="emjay-card rounded-2xl p-7 sm:p-8 mt-4">
      <div class="flex items-center justify-between">
        <p class="font-mono2 text-[11px] tracking-[0.2em] uppercase" style="color: var(--emjay-stamp)">
          ◐ Conlang — off-site
        </p>
        <p class="font-mono2 text-[11px] opacity-50">NO DATA PUBLISHED</p>
      </div>
      <p class="mt-4 leading-relaxed text-muted">
        I'm developing a conlang for Urth. To keep it clearly human-written for RP, I'm not
        publishing lexicon entries, grammar, or examples here.
      </p>
    </div>

    <p class="mt-8 text-sm">
      <a href="/xcf-sync" class="font-mono2 text-sm font-semibold hover:underline underline-offset-4">$ open xcf-sync — the map pipeline</a>
      <span class="mx-2 opacity-40">·</span>
      <a href="/powercordkit" class="font-mono2 text-sm hover:underline underline-offset-4">⌁ powercordkit</a>
    </p>
  </section>
</Layout>
